height:1.5}aside{align-self:center;padding:25px;background:#0d1b2b;border:1px solid var(--line);border-radius:15px}aside b{font-size:15px}aside p{color:var(--muted);font-size:13px;line-height:1.65}.text-link{display:inline-flex;margin-top:9px;font-size:13px;font-weight:700;text-decoration:none}.decision-runs{padding:62px 12px;border-top:1px solid var(--line)}.decision-table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--panel)}.decision-table-wrap table{width:100%;min-width:940px;border-collapse:collapse;text-align:left;font-size:12px}.decision-table-wrap caption{padding:14px;color:var(--muted);text-align:left}.decision-table-wrap th,.decision-table-wrap td{padding:13px 12px;border-top:1px solid var(--line);white-space:nowrap}.decision-table-wrap thead th{color:var(--muted);font-weight:700}.decision-table-wrap tbody th{color:var(--mint)}.decision-raw-links{display:flex;flex-wrap:wrap;gap:18px;margin-top:18px}.decision-raw-links a{font-size:12px;font-weight:700;text-decoration:none}.other-runs{padding:54px 0 16px;border-top:1px solid var(--line)}.run-list{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:28px 0}.run-list article{padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}.run-list article>div{display:flex;align-items:center;gap:12px}.run-list strong{font-size:33px;letter-spacing:-.04em;color:var(--mint)}.run-list span{font-weight:700;font-size:13px}.run-list p,.comparison-note,.prerequisite-lead,.setup-grid p{color:var(--muted);font-size:13px;line-height:1.65}.run-list a{font-size:12px;font-weight:700;text-decoration:none}.comparison-note{max-width:850px;margin:24px 0}.prerequisites{padding:54px 0 20px;border-top:1px solid var(--line)}.prerequisite-lead{max-width:780px}.setup-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:25px 0}.setup-grid article{padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}.setup-grid h3{font-size:20px;margin:0}.setup-grid p{margin:12px 0}.setup-grid code{display:block;padding:11px 12px;border-radius:8px;background:#08111f;color:var(--mint);font-size:11px;line-height:1.6;overflow-wrap:anywhere}.setup-grid a{display:inline-flex;margin-top:14px;font-size:12px;font-weight:700;text-decoration:none}
  @media(max-width:850px){.metrics-grid{grid-template-columns:repeat(2,1fr)}.conditions{grid-template-columns:1fr;gap:25px}.intro{margin-bottom:48px}}
