---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteBase } from "../utils/site.js";
import latestRun from "../../../benchmarks/results/miniwob-full-26-post-timeout-fix-20261002.json";
import latestDomRun from "../../../benchmarks/results/miniwob-dom-table-24-5b52abc-utf8.json";
import previousFullRun from "../../../benchmarks/results/miniwob-expanded-multi-tool-8ffc709.json";
import focusedRun from "../../../benchmarks/results/miniwob-targeted-browser-fixes-8490bd7.json";
import visualDigitsRun from "../../../benchmarks/results/miniwob-visual-digits-5-seed-smoke.json";
import visualDigitsRetryRun from "../../../benchmarks/results/miniwob-visual-digits-single-char-retry-5-seed-smoke.json";
import visualVisionRun from "../../../benchmarks/results/vision-smoke.json";
import visualOcrRun from "../../../benchmarks/results/ocr-smoke.json";
import currentEightTaskRun from "../../../benchmarks/results/miniwob-main-8-seed7-smoke.json";
import repeatedEightTaskRun from "../../../benchmarks/results/miniwob-current-dom-8x5-20261002.json";
import pairedMiniLMRun from "../../../benchmarks/results/miniwob-local-provider-paired-20261002-semantic.json";
import pairedNliRun from "../../../benchmarks/results/miniwob-local-provider-paired-20261002-nli.json";
import pairedProviderComparison from "../../../benchmarks/results/miniwob-local-provider-paired-comparison-20261002.json";
import cpuDecisionRepeat1 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-20261002.json";
import cpuDecisionRepeat2 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-2-20261002.json";
import cpuDecisionRepeat3 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-3-20261002.json";
import cpuDecisionRepeat4 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-4-20261002.json";
import cpuDecisionRepeat5 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-5-20261002.json";
import dmlDecisionRepeat1 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-20261002.json";
import dmlDecisionRepeat2 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-2-20261002.json";
import dmlDecisionRepeat3 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-3-20261002.json";
import dmlDecisionRepeat4 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-4-20261002.json";
import dmlDecisionRepeat5 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-5-20261002.json";
import dmlNodeProfile from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-node-profile-20261002.json";
import nliCpuRepeat1 from "../../../benchmarks/results/decisions-confirmation-nli-cpu-repeat-20261002-1.json";
import nliCpuRepeat2 from "../../../benchmarks/results/decisions-confirmation-nli-cpu-repeat-20261002-2.json";
import nliCpuRepeat3 from "../../../benchmarks/results/decisions-confirmation-nli-cpu-repeat-20261002-3.json";
import nliCpuRepeat4 from "../../../benchmarks/results/decisions-confirmation-nli-cpu-repeat-20261002-4.json";
import nliCpuRepeat5 from "../../../benchmarks/results/decisions-confirmation-nli-cpu-repeat-20261002-5.json";
import nliDmlRepeat1 from "../../../benchmarks/results/decisions-confirmation-nli-dml-repeat-20261002-1.json";
import nliDmlRepeat2 from "../../../benchmarks/results/decisions-confirmation-nli-dml-repeat-20261002-2.json";
import nliDmlRepeat3 from "../../../benchmarks/results/decisions-confirmation-nli-dml-repeat-20261002-3.json";
import nliDmlRepeat4 from "../../../benchmarks/results/decisions-confirmation-nli-dml-repeat-20261002-4.json";
import nliDmlRepeat5 from "../../../benchmarks/results/decisions-confirmation-nli-dml-repeat-20261002-5.json";
import nliDmlNodeProfile from "../../../benchmarks/results/decisions-confirmation-nli-dml-node-profile-20261002.json";
import nliBrowserCpuRun from "../../../benchmarks/results/miniwob-nli-device-20261002-cpu.json";
import nliBrowserDmlRun from "../../../benchmarks/results/miniwob-nli-device-20261002-dml.json";
import nliBrowserComparison from "../../../benchmarks/results/miniwob-nli-device-20261002-comparison.json";
import verifiedNavigationPreviousRun from "../../../benchmarks/results/webarena-verified-docker-b-localhost-18-20261002-summary.json";
import verifiedNavigationRun from "../../../benchmarks/results/webarena-verified-docker-b-page-settle-18-20261002-summary.json";
import verifiedNavigationBaseline from "../../../benchmarks/results/webarena-verified-shopping-admin-initial-18-task-baseline.json";
import remoteVerifiedNavigationRun from "../../../benchmarks/results/webarena-verified-docker-b-18-summary.json";
import catalogSweep from "../../../benchmarks/results/miniwob-all-125-catalog-sweep-20261002.json";

const episodeCount = latestRun.episodeCount;
const successCount = latestRun.successCount;
const failureCount = episodeCount - successCount;
const successPercent = Math.round(latestRun.taskSuccessRate * 100);
const environment = latestRun.rawRecords[0];
const repeatedEightTaskSource = repeatedEightTaskRun.rawRecords[0];
const commitUrl = `https://github.com/krmdl/agent-decision-kit/commit/${latestRun.suite.agentDecisionKitCommit}`;
const rawRunUrl = "https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-full-26-post-timeout-fix-20261002.json";
const verifiedNavigationCount = verifiedNavigationRun.episodeCount;
const verifiedNavigationSuccesses = verifiedNavigationRun.successCount;
const verifiedNavigationPartial = verifiedNavigationRun.partialRewardCount;
const verifiedNavigationDecisionP95 = verifiedNavigationRun.decisionCallLatencyMs.p95;
const verifiedNavigationPreviousDecisionP95 = verifiedNavigationPreviousRun.decisionCallLatencyMs.p95;
const verifiedNavigationBaselineMeanReward = verifiedNavigationBaseline.meanReward;
const remoteVerifiedNavigationCount = remoteVerifiedNavigationRun.episodeCount;
const remoteVerifiedNavigationDecisionP95 = remoteVerifiedNavigationRun.decisionCallLatencyMs.p95;
const catalogSweepSuccessPercent = Math.round(catalogSweep.taskSuccessRate * 100);
const catalogSweepRawRunUrl = "https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-all-125-catalog-sweep-20261002.json";
const catalogSweepCommitUrl = `https://github.com/krmdl/agent-decision-kit/commit/${catalogSweep.suite.agentDecisionKitCommit}`;
const cpuDecisionRuns = [cpuDecisionRepeat1, cpuDecisionRepeat2, cpuDecisionRepeat3, cpuDecisionRepeat4, cpuDecisionRepeat5];
const dmlDecisionRuns = [dmlDecisionRepeat1, dmlDecisionRepeat2, dmlDecisionRepeat3, dmlDecisionRepeat4, dmlDecisionRepeat5];
const nliCpuRuns = [nliCpuRepeat1, nliCpuRepeat2, nliCpuRepeat3, nliCpuRepeat4, nliCpuRepeat5];
const nliDmlRuns = [nliDmlRepeat1, nliDmlRepeat2, nliDmlRepeat3, nliDmlRepeat4, nliDmlRepeat5];
const median = (values: number[]) => {
  const ordered = [...values].sort((left, right) => left - right);
  const middle = Math.floor(ordered.length / 2);
  return ordered.length % 2 ? ordered[middle]! : Math.round((ordered[middle - 1]! + ordered[middle]!) / 2);
};
const nearestRankP95 = (values: number[]) => {
  const ordered = [...values].sort((left, right) => left - right);
  return ordered[Math.ceil(ordered.length * 0.95) - 1]!;
};
const summarizeDecisionRuns = (reports: typeof cpuDecisionRuns) => {
  const p95Values = reports.map((report) => report.latencyMs.withinProcessSteadyState.p95);
  const allCallLatencies = reports.flatMap((report) => report.records.map((record) => record.latencyMs));
  return {
    firstCall: median(reports.map((report) => report.latencyMs.firstCallIncludingInitialization)),
    firstCallMax: Math.max(...reports.map((report) => report.latencyMs.firstCallIncludingInitialization)),
    allCallP95: nearestRankP95(allCallLatencies),
    allCallCount: allCallLatencies.length,
    p50: median(reports.map((report) => report.latencyMs.withinProcessSteadyState.p50)),
    p95: median(p95Values),
    p95Min: Math.min(...p95Values),
    p95Max: Math.max(...p95Values),
  };
};
const cpuDecisionSummary = summarizeDecisionRuns(cpuDecisionRuns);
const dmlDecisionSummary = summarizeDecisionRuns(dmlDecisionRuns);
const nliCpuSummary = summarizeDecisionRuns(nliCpuRuns);
const nliDmlSummary = summarizeDecisionRuns(nliDmlRuns);
const dmlSlowerInEveryPair = dmlDecisionRuns.every((report, index) =>
  report.latencyMs.withinProcessSteadyState.p95 > cpuDecisionRuns[index]!.latencyMs.withinProcessSteadyState.p95);
const allWarmP95Under500 = [...cpuDecisionRuns, ...dmlDecisionRuns]
  .every((report) => report.latencyMs.withinProcessSteadyState.p95 < 500);
const dmlProviderCounts = dmlNodeProfile.runtime.onnxExecutionProviderNodeCounts;
const dmlProviderCallCount = dmlNodeProfile.sampleCount;
const nliDmlProviderCounts = nliDmlNodeProfile.runtime.onnxExecutionProviderNodeCounts;
const nliDmlProviderEventCount = Object.values(nliDmlProviderCounts).reduce((total, count) => total + count, 0);
const nliCpuOutputsStable = nliCpuRuns.every((report) => report.records.every((record, index) =>
  record.id === nliCpuRuns[0]!.records[index]!.id && JSON.stringify(record.prediction) === JSON.stringify(nliCpuRuns[0]!.records[index]!.prediction)));
const nliDmlOutputsStable = nliDmlRuns.every((report) => report.records.every((record, index) =>
  record.id === nliDmlRuns[0]!.records[index]!.id && JSON.stringify(record.prediction) === JSON.stringify(nliDmlRuns[0]!.records[index]!.prediction)));
const nliCrossDeviceDisagreements = nliCpuRuns[0]!.records.filter((record, index) =>
  JSON.stringify(record.prediction) !== JSON.stringify(nliDmlRuns[0]!.records[index]!.prediction)).length;
const nliDecisionRows = [
  { device: "CPU", runs: nliCpuRuns, summary: nliCpuSummary },
  { device: "DirectML + CPU fallback", runs: nliDmlRuns, summary: nliDmlSummary },
].map(({ device, runs, summary }) => {
  const report = runs[0]!;
  return {
    device,
    firstCall: summary.firstCall,
    firstCallMax: summary.firstCallMax,
    allCallP95: summary.allCallP95,
    allCallCount: summary.allCallCount,
    p50: summary.p50,
    p95: summary.p95,
    p95Min: summary.p95Min,
    p95Max: summary.p95Max,
    choice: `${Math.round(report.byQuestionType.choice.accuracy * report.byQuestionType.choice.sampleCount)}/${report.byQuestionType.choice.sampleCount}`,
    yesNo: `${Math.round(report.byQuestionType.noul.accuracy * report.byQuestionType.noul.sampleCount)}/${report.byQuestionType.noul.sampleCount}`,
    scoreMae: report.byQuestionType.score.meanAbsoluteError,
  };
});
const decisionRows = [
  { device: "CPU", report: cpuDecisionRuns[0], summary: cpuDecisionSummary },
  { device: "DirectML + CPU fallback", report: dmlDecisionRuns[0], summary: dmlDecisionSummary },
].map(({ device, report, summary }) => {
  const reliability = report.confidenceReliability.find((item) => item.outcome === "predicted choice/yes-no correctness");
  return {
    device,
    firstCall: summary.firstCall,
    p50: summary.p50,
    p95: summary.p95,
    allCallP95: summary.allCallP95,
    allCallCount: summary.allCallCount,
    p95Min: summary.p95Min,
    p95Max: summary.p95Max,
    warmCount: report.latencyMs.withinProcessSteadyState.sampleCount,
    choiceCorrect: Math.round(report.byQuestionType.choice.accuracy * report.byQuestionType.choice.sampleCount),
    choiceTotal: report.byQuestionType.choice.sampleCount,
    yesNoCorrect: Math.round(report.byQuestionType.noul.accuracy * report.byQuestionType.noul.sampleCount),
    yesNoTotal: report.byQuestionType.noul.sampleCount,
    choiceBrier: report.byQuestionType.choice.meanBrierScore,
    yesNoBrier: report.byQuestionType.noul.meanBrierScore,
    scoreMae: report.byQuestionType.score.meanAbsoluteError,
    ece: reliability?.expectedCalibrationError ?? null,
    eceCount: reliability?.sampleCount ?? 0,
  };
});
---

<BaseLayout title="Real Browser Automation Benchmarks | Agent Decision Kit" description="Reproducible BrowserGym MiniWoB and WebArena Verified results for Agent Decision Kit, with task success, latency, environment details, and raw episodes." canonicalPath="benchmarks/">
  <main class="page">
    <header class="intro">
      <p class="eyebrow">MEASURED RUNS · RAW EPISODES INCLUDED</p>
      <h1>Browser automation<br /><span>with the limits in view.</span></h1>
      <p class="lead">Real BrowserGym MiniWoB runs from this repository. Each report keeps task success, latency, failures, and the environment together so a small smoke run stays a small claim.</p>
    </header>

    <section class="latest" aria-labelledby="catalog-sweep-title">
      <div class="section-heading">
        <p class="eyebrow">125-TASK MINIWOB CATALOG SWEEP · ONE SEED</p>
        <h2 id="catalog-sweep-title">{catalogSweep.successCount} of {catalogSweep.episodeCount} tasks reached full reward.</h2>
        <p>This Windows CPU run covers the 125 tasks registered in the pinned BrowserGym MiniWoB package, using seed 7 and at most 12 bounded BrowserManager action rounds per task. It measures a tool integration path with the local semantic provider and exact local rules; it is not a full autonomous agent or a general web task score. The failures remain in the report so the limits are visible.</p>
        <p class="comparison-note">Every task requires raw reward ≥ 1.0. {catalogSweep.partialRewardCount} other tasks earned positive partial raw reward; the remaining {catalogSweep.episodeCount - catalogSweep.successCount - catalogSweep.partialRewardCount} had zero or negative raw reward. The run had {catalogSweep.timeoutRate * 100}% harness timeouts. Only <code>browser_connect</code>, <code>browser_decide_and_act</code>, and <code>browser_confirm</code> were exercised. This is one seed from one host, not a held-out quality estimate.</p>
      </div>

      <figure class="success-chart">
        <div class="bar" role="img" aria-label={`${catalogSweep.successCount} tasks succeeded and ${catalogSweep.episodeCount - catalogSweep.successCount} did not succeed, out of ${catalogSweep.episodeCount}`}>
          <span class="passed" style={`width:${catalogSweepSuccessPercent}%`} aria-hidden="true"></span>
          <span class="failed" style={`width:${100 - catalogSweepSuccessPercent}%`} aria-hidden="true"></span>
        </div>
        <figcaption>
          <span><i class="legend passed-key"></i>{catalogSweep.successCount} succeeded</span>
          <span><i class="legend failed-key"></i>{catalogSweep.episodeCount - catalogSweep.successCount} did not reach full reward</span>
          <span>0 harness timeouts</span>
        </figcaption>
      </figure>

      <div class="metrics-grid">
        <article class="metric"><p class="eyebrow">FULL TASK REWARD</p><strong>{catalogSweep.successCount}/{catalogSweep.episodeCount}</strong><span>{catalogSweepSuccessPercent}% on this one-seed catalog sweep</span></article>
        <article class="metric"><p class="eyebrow">BROWSER LOOP P50 / P95</p><strong>{catalogSweep.agentActionLatencyMs.p50} / {catalogSweep.agentActionLatencyMs.p95}ms</strong><span>125 episodes; includes BrowserManager inspection and action</span></article>
        <article class="metric"><p class="eyebrow">MODEL CALL P50 / P95</p><strong>{catalogSweep.decisionCallLatencyMs.p50} / {catalogSweep.decisionCallLatencyMs.p95}ms</strong><span>{catalogSweep.decisionCallLatencyMs.sampleCount} CPU calls; exact local rules made the other selections</span></article>
        <article class="metric"><p class="eyebrow">END-TO-END P50 / P95</p><strong>{catalogSweep.latencyMs.p50} / {catalogSweep.latencyMs.p95}ms</strong><span>Includes environment reset for each task</span></article>
      </div>
      <p class="comparison-note">Base source: <a href={catalogSweepCommitUrl}>{catalogSweep.suite.agentDecisionKitCommit.slice(0, 7)}</a>; benchmark used a modified working tree. BrowserGym {catalogSweep.rawRecords[0].browserGymVersion}, MiniWoB++ commit {catalogSweep.rawRecords[0].miniWobCommit.slice(0, 7)}, Node {catalogSweep.rawRecords[0].nodeVersion}, Python {catalogSweep.rawRecords[0].pythonVersion}, Windows 10, CPU. The pinned <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/miniwob-browsergym-0.14.3-tasks.txt">task list</a> and <a href={catalogSweepRawRunUrl}>raw episode summary</a> are available in the repository.</p>
    </section>

    <section class="latest" aria-labelledby="latest-title">
      <div class="section-heading">
        <p class="eyebrow">26-TASK MINIWoB MULTI-TOOL RUN</p>
        <h2 id="latest-title">{successCount} of {episodeCount} tasks succeeded.</h2>
        <p>This Windows CPU run completed 26/26 curated MiniWoB tasks with no harness timeouts. It exercises DOM selection, bounded form/table workflows, sliders, and OCR clicks on the visual-only <code>ascending-numbers</code> task. The read-only date-picker regression selects the exact visible day before separately asking approval to submit. The <code>daily-calendar</code> flow calls the OCR-capable viewport-scroll tool, then uses explicit task values and fixed coordinates from the pinned page's 332×214 pixel grid for an approval-gated drag and local event creation. This is a visual-tool integration check, not OCR target detection, a general vision-model result, or autonomous coding-agent score.</p>
        <p class="comparison-note">Task success requires a raw MiniWoB reward of at least 1.0; positive partial rewards count as failures. This avoids BrowserGym 0.14.3's partial-reward-to-success conversion documented in <a href="https://github.com/ServiceNow/BrowserGym/issues/392">upstream issue 392</a>.</p>
      </div>

      <figure class="success-chart">
        <div class="bar" role="img" aria-label={`${successCount} tasks succeeded and ${failureCount} tasks did not succeed, out of ${episodeCount}`}>
          <span class="passed" style={`width:${successPercent}%`} aria-hidden="true"></span>
          <span class="failed" style={`width:${100 - successPercent}%`} aria-hidden="true"></span>
        </div>
        <figcaption>
          <span><i class="legend passed-key"></i>{successCount} succeeded</span>
          <span><i class="legend failed-key"></i>{failureCount} did not reach the task goal</span>
          <span>0 harness timeouts</span>
        </figcaption>
      </figure>

      <div class="metrics-grid">
        <article class="metric"><p class="eyebrow">TASK SUCCESS</p><strong>{successCount}/{episodeCount}</strong><span>{successPercent}% on this curated set</span></article>
        <article class="metric"><p class="eyebrow">BROWSER LOOP P50</p><strong>{(latestRun.agentActionLatencyMs.p50 / 1000).toFixed(2)}s</strong><span>Includes tool actions and inspection</span></article>
        <article class="metric"><p class="eyebrow">BROWSER LOOP P95</p><strong>{(latestRun.agentActionLatencyMs.p95 / 1000).toFixed(2)}s</strong><span>Includes browser inspection, selection, and actions</span></article>
        <article class="metric"><p class="eyebrow">DECISION CALL P95</p><strong>{latestRun.decisionCallLatencyMs.p95}ms</strong><span>Three local semantic calls across 26 episodes</span></article>
      </div>
    </section>

    <section class="conditions" aria-labelledby="conditions-title">
      <div>
        <p class="eyebrow">REPRODUCTION DETAILS</p>
        <h2 id="conditions-title">A CPU run with a fixed DOM task set.</h2>
        <dl>
          <div><dt>Base source commit</dt><dd><a href={commitUrl}>{latestRun.suite.agentDecisionKitCommit.slice(0, 7)}</a> · benchmark used a modified working tree</dd></div>
          <div><dt>Benchmark</dt><dd>BrowserGym MiniWoB 0.14.3</dd></div>
          <div><dt>Browser and runtimes</dt><dd>{environment.browserVersion} · Node {environment.nodeVersion} · Python {environment.pythonVersion} · Playwright Python {environment.playwrightPythonVersion} / Node {environment.playwrightNodeVersion}</dd></div>
          <div><dt>Machine</dt><dd>Windows 10 Pro · {environment.cpuModel}</dd></div>
          <div><dt>Runner</dt><dd>Native Windows browser process · CPU · no Docker container</dd></div>
          <div><dt>Task set</dt><dd>26 curated DOM and visual tasks · seed 7 · eight actions per task</dd></div>
          <div><dt>Model path</dt><dd>Local semantic rules, OCR, and the pinned calendar's fixed pixel-grid flow</dd></div>
        </dl>
      </div>
      <aside>
        <b>How to read the latency</b>
        <p>Total task time includes BrowserGym environment reset: p50 {(latestRun.latencyMs.p50 / 1000).toFixed(2)} s / p95 {(latestRun.latencyMs.p95 / 1000).toFixed(2)} s. The browser tool loop had p50 {latestRun.agentActionLatencyMs.p50} ms / p95 {latestRun.agentActionLatencyMs.p95} ms. Three measured local semantic calls had p50 {latestRun.decisionCallLatencyMs.p50} ms / p95 {latestRun.decisionCallLatencyMs.p95} ms. These samples do not establish warm throughput or the consumer-GPU target.</p>
        <p>OCR visual clicks and the daily-calendar drag were separately approved by the synthetic harness and restricted to the local MiniWoB page. The daily-calendar path uses known geometry from its pinned fixture; it does not measure OCR target detection or a general vision agent.</p>
        <a class="text-link" href={rawRunUrl}>Inspect the summary and all raw episodes ↗</a>
      </aside>
    </section>

    <section class="decision-runs" aria-labelledby="paired-provider-title">
      <p class="eyebrow">PAIRED BROWSER PROVIDER RUN · CPU</p>
      <h2 id="paired-provider-title">The same DOM tasks, with both local providers.</h2>
      <p class="comparison-note">Five seeds repeated the same eight MiniWoB tasks for each provider on Windows 10 and a Ryzen 5 5600H CPU. All 40 episodes per provider reached full task reward without a harness timeout or an outcome disagreement. Only 11 episodes per provider called the semantic model; all other selections came from exact local rules.</p>
      <div class="decision-table-wrap">
        <table>
          <caption>Forty episodes per provider · first model inference in a fresh bridge process · model files cached</caption>
          <thead><tr><th scope="col">Provider</th><th scope="col">Task success</th><th scope="col">End-to-end p50 / p95</th><th scope="col">Browser loop p50 / p95</th><th scope="col">Decision call p50 / p95</th><th scope="col">Mean action rounds</th></tr></thead>
          <tbody>
            {[
              { label: "MiniLM · semantic-local", report: pairedMiniLMRun },
              { label: "NLI · semantic-nli", report: pairedNliRun },
            ].map(({ label, report }) => <tr>
              <th scope="row">{label}</th>
              <td>{report.successCount}/{report.episodeCount}</td>
              <td>{report.latencyMs.p50} / {report.latencyMs.p95} ms</td>
              <td>{report.agentActionLatencyMs.p50} / {report.agentActionLatencyMs.p95} ms</td>
              <td>{report.decisionCallLatencyMs.p50} / {report.decisionCallLatencyMs.p95} ms (n={report.decisionCallLatencyMs.sampleCount})</td>
              <td>{report.actions.mean.toFixed(2)}</td>
            </tr>)}
          </tbody>
        </table>
      </div>
      <figure class="provider-chart">
        <img src={`${siteBase}images/miniwob-local-provider-latency-20261002.svg`} alt="MiniWoB CPU semantic decision latency chart: MiniLM p50/p95 173/182 milliseconds, NLI 810/848 milliseconds, with 11 calls per provider." width="960" height="390" loading="lazy" />
        <figcaption>Real decision-call measurements from the linked 40-episode reports; this graph excludes deterministic local-rule selections.</figcaption>
      </figure>
      <p class="comparison-note">In this CPU run, NLI's model-call p50 was about 4.7× MiniLM's (810 ms vs 173 ms). The median paired delta for the full browser loop was only +6 ms because model inference occurred in 11 of 40 episodes and environment reset dominates total time. Every episode starts a fresh bridge, so these model calls include process-level pipeline initialization; this does not measure warm requests to a persistent MCP server, GPU latency, or broad task quality. Confidence estimates remain uncalibrated. The measurement supports no general speed claim.</p>
      <div class="decision-raw-links">
        <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-local-provider-paired-20261002-semantic.json">MiniLM raw episodes ↗</a>
        <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-local-provider-paired-20261002-nli.json">NLI raw episodes ↗</a>
        <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-local-provider-paired-comparison-20261002.json">Paired metric report ↗</a>
        <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/compare-browsergym-runs.py">Comparison code ↗</a>
      </div>
    </section>

    <section class="decision-runs" aria-labelledby="decision-runs-title">
      <p class="eyebrow">LOCAL DECISION DEVICE CHECK</p>
      <h2 id="decision-runs-title">CPU was faster on this small model.</h2>
      <p class="comparison-note">Each device row summarizes five matched runs over the same 30 project-specific labels on one Windows 10 Ryzen 5 5600H laptop with a GeForce GTX 1650 (4 GB, reported by <code>nvidia-smi</code>). The model-cache directory existed before each process, but individual cached files were not checked. A separate DirectML profile records which ONNX execution provider handled each node.</p>
      <div class="decision-table-wrap">
        <table>
          <caption>Five paired runs · 29 warm calls per run · labels are not held out</caption>
