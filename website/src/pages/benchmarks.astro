---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteBase } from "../utils/site.js";
import latestRun from "../../../benchmarks/results/miniwob-dom-table-24-5b52abc-utf8.json";
import previousFullRun from "../../../benchmarks/results/miniwob-expanded-multi-tool-8ffc709.json";
import focusedRun from "../../../benchmarks/results/miniwob-targeted-browser-fixes-8490bd7.json";
import visualDigitsRun from "../../../benchmarks/results/miniwob-visual-digits-5-seed-smoke.json";
import visualDigitsRetryRun from "../../../benchmarks/results/miniwob-visual-digits-single-char-retry-5-seed-smoke.json";
import currentEightTaskRun from "../../../benchmarks/results/miniwob-main-8-seed7-smoke.json";
import repeatedEightTaskRun from "../../../benchmarks/results/miniwob-main-8-seed7-11-post-menu-fix-40.json";
import cpuDecisionRepeat1 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-20261002.json";
import cpuDecisionRepeat2 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-2-20261002.json";
import cpuDecisionRepeat3 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-3-20261002.json";
import cpuDecisionRepeat4 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-4-20261002.json";
import cpuDecisionRepeat5 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-5-20261002.json";
import dmlDecisionRepeat1 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-20261002.json";
import dmlDecisionRepeat2 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-2-20261002.json";
import dmlDecisionRepeat3 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-3-20261002.json";
import dmlDecisionRepeat4 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-4-20261002.json";
import dmlDecisionRepeat5 from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-5-20261002.json";
import dmlNodeProfile from "../../../benchmarks/results/decision-cases-independent-ryzen5600h-dml-node-profile-20261002.json";
import verifiedNavigationPreviousRun from "../../../benchmarks/results/webarena-verified-docker-b-localhost-18-20261002-summary.json";
import verifiedNavigationRun from "../../../benchmarks/results/webarena-verified-docker-b-page-settle-18-20261002-summary.json";
import verifiedNavigationBaseline from "../../../benchmarks/results/webarena-verified-shopping-admin-initial-18-task-baseline.json";
import remoteVerifiedNavigationRun from "../../../benchmarks/results/webarena-verified-docker-b-18-summary.json";

const episodeCount = latestRun.episodeCount;
const successCount = latestRun.successCount;
const failureCount = episodeCount - successCount;
const successPercent = Math.round(latestRun.taskSuccessRate * 100);
const environment = latestRun.rawRecords[0];
const commitUrl = `https://github.com/krmdl/agent-decision-kit/commit/${latestRun.suite.agentDecisionKitCommit}`;
const rawRunUrl = "https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-dom-table-24-5b52abc-utf8.json";
const verifiedNavigationCount = verifiedNavigationRun.episodeCount;
const verifiedNavigationSuccesses = verifiedNavigationRun.successCount;
const verifiedNavigationPartial = verifiedNavigationRun.partialRewardCount;
const verifiedNavigationDecisionP95 = verifiedNavigationRun.decisionCallLatencyMs.p95;
const verifiedNavigationPreviousDecisionP95 = verifiedNavigationPreviousRun.decisionCallLatencyMs.p95;
const verifiedNavigationBaselineMeanReward = verifiedNavigationBaseline.meanReward;
const remoteVerifiedNavigationCount = remoteVerifiedNavigationRun.episodeCount;
const remoteVerifiedNavigationDecisionP95 = remoteVerifiedNavigationRun.decisionCallLatencyMs.p95;
const cpuDecisionRuns = [cpuDecisionRepeat1, cpuDecisionRepeat2, cpuDecisionRepeat3, cpuDecisionRepeat4, cpuDecisionRepeat5];
const dmlDecisionRuns = [dmlDecisionRepeat1, dmlDecisionRepeat2, dmlDecisionRepeat3, dmlDecisionRepeat4, dmlDecisionRepeat5];
const median = (values: number[]) => {
  const ordered = [...values].sort((left, right) => left - right);
  const middle = Math.floor(ordered.length / 2);
  return ordered.length % 2 ? ordered[middle]! : Math.round((ordered[middle - 1]! + ordered[middle]!) / 2);
};
const summarizeDecisionRuns = (reports: typeof cpuDecisionRuns) => {
  const p95Values = reports.map((report) => report.latencyMs.withinProcessSteadyState.p95);
  return {
    firstCall: median(reports.map((report) => report.latencyMs.firstCallIncludingInitialization)),
    firstCallMax: Math.max(...reports.map((report) => report.latencyMs.firstCallIncludingInitialization)),
    p50: median(reports.map((report) => report.latencyMs.withinProcessSteadyState.p50)),
    p95: median(p95Values),
    p95Min: Math.min(...p95Values),
    p95Max: Math.max(...p95Values),
  };
};
const cpuDecisionSummary = summarizeDecisionRuns(cpuDecisionRuns);
const dmlDecisionSummary = summarizeDecisionRuns(dmlDecisionRuns);
const dmlSlowerInEveryPair = dmlDecisionRuns.every((report, index) =>
  report.latencyMs.withinProcessSteadyState.p95 > cpuDecisionRuns[index]!.latencyMs.withinProcessSteadyState.p95);
const allWarmP95Under500 = [...cpuDecisionRuns, ...dmlDecisionRuns]
  .every((report) => report.latencyMs.withinProcessSteadyState.p95 < 500);
const dmlProviderCounts = dmlNodeProfile.runtime.onnxExecutionProviderNodeCounts;
const dmlProviderCallCount = dmlNodeProfile.sampleCount;
const decisionRows = [
  { device: "CPU", report: cpuDecisionRuns[0], summary: cpuDecisionSummary },
  { device: "DirectML + CPU fallback", report: dmlDecisionRuns[0], summary: dmlDecisionSummary },
].map(({ device, report, summary }) => {
  const reliability = report.confidenceReliability.find((item) => item.outcome === "predicted choice/yes-no correctness");
  return {
    device,
    firstCall: summary.firstCall,
    p50: summary.p50,
    p95: summary.p95,
    p95Min: summary.p95Min,
    p95Max: summary.p95Max,
    warmCount: report.latencyMs.withinProcessSteadyState.sampleCount,
    choiceCorrect: Math.round(report.byQuestionType.choice.accuracy * report.byQuestionType.choice.sampleCount),
    choiceTotal: report.byQuestionType.choice.sampleCount,
    yesNoCorrect: Math.round(report.byQuestionType.noul.accuracy * report.byQuestionType.noul.sampleCount),
    yesNoTotal: report.byQuestionType.noul.sampleCount,
    choiceBrier: report.byQuestionType.choice.meanBrierScore,
    yesNoBrier: report.byQuestionType.noul.meanBrierScore,
    scoreMae: report.byQuestionType.score.meanAbsoluteError,
    ece: reliability?.expectedCalibrationError ?? null,
    eceCount: reliability?.sampleCount ?? 0,
  };
});
---

<BaseLayout title="Real Browser Automation Benchmarks | Agent Decision Kit" description="Reproducible BrowserGym MiniWoB and WebArena Verified results for Agent Decision Kit, with task success, latency, environment details, and raw episodes." canonicalPath="benchmarks/">
  <main class="page">
    <header class="intro">
      <p class="eyebrow">MEASURED RUNS · RAW EPISODES INCLUDED</p>
      <h1>Browser automation<br /><span>with the limits in view.</span></h1>
      <p class="lead">Real BrowserGym MiniWoB runs from this repository. Each report keeps task success, latency, failures, and the environment together so a small smoke run stays a small claim.</p>
    </header>

    <section class="latest" aria-labelledby="latest-title">
      <div class="section-heading">
      <p class="eyebrow">LATEST DOM MULTI-TOOL INTEGRATION</p>
        <h2 id="latest-title">{successCount} of {episodeCount} tasks succeeded.</h2>
        <p>This Windows CPU run completed 24 selected DOM tasks from the earlier 26-task MiniWoB set. It excludes the visual-only <code>ascending-numbers</code> and <code>daily-calendar</code> tasks. The bounded harness extracts explicit targets from synthetic task instructions, reads unique values from visible HTML tables, uses <code>browser_copy_field</code> and <code>browser_set_checkboxes</code> for local form workflows, and exercises <code>browser_set_range</code> on keyboard-operated sliders. Each Submit action receives a separate local-only synthetic approval. The previous full 26-task run completed {previousFullRun.successCount}/{previousFullRun.episodeCount}; it is a different task set and machine, so the rates should not be compared directly. This measures tool integration, not an autonomous coding-agent score.</p>
        <p class="comparison-note">Task success requires a raw MiniWoB reward of at least 1.0; positive partial rewards count as failures. This avoids BrowserGym 0.14.3's partial-reward-to-success conversion documented in <a href="https://github.com/ServiceNow/BrowserGym/issues/392">upstream issue 392</a>.</p>
      </div>

      <figure class="success-chart">
        <div class="bar" role="img" aria-label={`${successCount} tasks succeeded and ${failureCount} tasks did not succeed, out of ${episodeCount}`}>
          <span class="passed" style={`width:${successPercent}%`} aria-hidden="true"></span>
          <span class="failed" style={`width:${100 - successPercent}%`} aria-hidden="true"></span>
        </div>
        <figcaption>
          <span><i class="legend passed-key"></i>{successCount} succeeded</span>
          <span><i class="legend failed-key"></i>{failureCount} did not reach the task goal</span>
          <span>0 harness timeouts</span>
        </figcaption>
      </figure>

      <div class="metrics-grid">
        <article class="metric"><p class="eyebrow">TASK SUCCESS</p><strong>{successCount}/{episodeCount}</strong><span>{successPercent}% on this curated set</span></article>
        <article class="metric"><p class="eyebrow">BROWSER LOOP P50</p><strong>{(latestRun.agentActionLatencyMs.p50 / 1000).toFixed(2)}s</strong><span>Includes tool actions and inspection</span></article>
        <article class="metric"><p class="eyebrow">BROWSER LOOP P95</p><strong>{(latestRun.agentActionLatencyMs.p95 / 1000).toFixed(2)}s</strong><span>Includes browser inspection, selection, and actions</span></article>
        <article class="metric"><p class="eyebrow">DECISION CALL P95</p><strong>{latestRun.decisionCallLatencyMs.p95}ms</strong><span>Four local semantic calls across 24 episodes</span></article>
      </div>
    </section>

    <section class="conditions" aria-labelledby="conditions-title">
      <div>
        <p class="eyebrow">REPRODUCTION DETAILS</p>
        <h2 id="conditions-title">A CPU run with a fixed DOM task set.</h2>
        <dl>
          <div><dt>Base source commit</dt><dd><a href={commitUrl}>{latestRun.suite.agentDecisionKitCommit.slice(0, 7)}</a> · benchmark used a modified working tree</dd></div>
          <div><dt>Benchmark</dt><dd>BrowserGym MiniWoB 0.14.3</dd></div>
          <div><dt>Browser and runtimes</dt><dd>{environment.browserVersion} · Node {environment.nodeVersion} · Python {environment.pythonVersion} · Playwright Python {environment.playwrightPythonVersion} / Node {environment.playwrightNodeVersion}</dd></div>
          <div><dt>Machine</dt><dd>Windows 10 Pro · {environment.cpuModel}</dd></div>
          <div><dt>Runner</dt><dd>Native Windows browser process · CPU · no Docker container</dd></div>
          <div><dt>Task set</dt><dd>24 curated DOM tasks · seed 7 · eight actions per task; excludes two visual-only tasks</dd></div>
          <div><dt>Model path</dt><dd>Local semantic model · no vision call or remote decision provider in this run</dd></div>
        </dl>
      </div>
      <aside>
        <b>How to read the latency</b>
        <p>Total task time includes BrowserGym environment reset: p50 {(latestRun.latencyMs.p50 / 1000).toFixed(2)} s / p95 {(latestRun.latencyMs.p95 / 1000).toFixed(2)} s. The browser tool loop had p50 {latestRun.agentActionLatencyMs.p50} ms / p95 {latestRun.agentActionLatencyMs.p95} ms. Four measured local semantic calls had p50 {latestRun.decisionCallLatencyMs.p50} ms / p95 {latestRun.decisionCallLatencyMs.p95} ms. These samples do not establish warm throughput or the consumer-GPU target.</p>
        <p>The visual-only tasks and OCR/visual action tools were not exercised. Every benchmark confirmation is synthetic and restricted by the harness to a local MiniWoB page.</p>
        <a class="text-link" href={rawRunUrl}>Inspect the summary and all raw episodes ↗</a>
      </aside>
    </section>

    <section class="decision-runs" aria-labelledby="decision-runs-title">
      <p class="eyebrow">LOCAL DECISION DEVICE CHECK</p>
      <h2 id="decision-runs-title">CPU was faster on this small model.</h2>
      <p class="comparison-note">Each device row summarizes five matched runs over the same 30 project-specific labels on one Windows 10 Ryzen 5 5600H laptop with a GeForce GTX 1650 (4 GB, reported by <code>nvidia-smi</code>). The model-cache directory existed before each process, but individual cached files were not checked. A separate DirectML profile records which ONNX execution provider handled each node.</p>
      <div class="decision-table-wrap">
        <table>
          <caption>Five paired runs · 29 warm calls per run · labels are not held out</caption>
          <thead><tr><th scope="col">Device</th><th scope="col">First call median (incl. init)</th><th scope="col">Warm p50 / p95 medians</th><th scope="col">Choice</th><th scope="col">Yes/no</th><th scope="col">Score MAE</th><th scope="col">Brier: Choice / yes-no</th><th scope="col">ECE (n=20)</th></tr></thead>
          <tbody>
            {decisionRows.map((row) => <tr>
              <th scope="row">{row.device}</th>
              <td>{row.firstCall} ms</td>
              <td>{row.p50} / {row.p95} ms (p95 range {row.p95Min}–{row.p95Max}; n=29/run)</td>
              <td>{row.choiceCorrect}/{row.choiceTotal}</td>
              <td>{row.yesNoCorrect}/{row.yesNoTotal}</td>
              <td>{row.scoreMae.toFixed(3)}</td>
              <td>{row.choiceBrier.toFixed(3)} / {row.yesNoBrier.toFixed(3)}</td>
              <td>{row.ece?.toFixed(3) ?? "not reported"}</td>
            </tr>)}
          </tbody>
        </table>
      </div>
      <p class="comparison-note">Across these five pairs, CPU warm p95 had a {cpuDecisionSummary.p95} ms median ({cpuDecisionSummary.p95Min}–{cpuDecisionSummary.p95Max} ms across run p95s); DirectML had a {dmlDecisionSummary.p95} ms median ({dmlDecisionSummary.p95Min}–{dmlDecisionSummary.p95Max} ms){dmlSlowerInEveryPair ? " and was slower in every pair" : ""}. A separate {dmlProviderCallCount}-call ONNX profile observed {dmlProviderCounts.DmlExecutionProvider.toLocaleString("en-US")} <code>DmlExecutionProvider</code> node events and {dmlProviderCounts.CPUExecutionProvider.toLocaleString("en-US")} <code>CPUExecutionProvider</code> events ({Math.round(dmlProviderCounts.DmlExecutionProvider / dmlProviderCallCount)} and {Math.round(dmlProviderCounts.CPUExecutionProvider / dmlProviderCallCount)} per call). This verifies DirectML execution with some CPU fallback, but node counts do not measure compute share. {allWarmP95Under500 ? "Every warm p95 in these runs stayed below 500 ms" : "At least one warm p95 in these runs reached 500 ms"}; DirectML first-call latency included initialization, with a {dmlDecisionSummary.firstCall} ms median and {dmlDecisionSummary.firstCallMax} ms maximum. This one machine and non-held-out fixture do not establish a general speed guarantee or GPU advantage. Confidence estimates remain uncalibrated; ECE is descriptive only.</p>
      <div class="decision-raw-links"><a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/decision-cases-independent-ryzen5600h-cpu-repeat-20261002.json">CPU raw run 1 ↗</a><a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/decision-cases-independent-ryzen5600h-dml-repeat-20261002.json">DirectML raw run 1 ↗</a><a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/decision-cases-independent-ryzen5600h-dml-node-profile-20261002.json">Node profile report ↗</a><a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/decision-cases-independent-ryzen5600h-dml-node-profile-20261002.onnx-profile.json.gz">Compressed ONNX trace ↗</a><a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/fixtures/decision-cases-independent.jsonl">30 labeled examples ↗</a></div>
    </section>

    <section class="other-runs" aria-labelledby="other-runs-title">
      <p class="eyebrow">OTHER RECORDED RUNS</p>
      <h2 id="other-runs-title">Different runs answer different questions.</h2>
      <div class="run-list">
        <article>
          <div><strong>{previousFullRun.successCount}/{previousFullRun.episodeCount}</strong><span>Prior full 26-task MiniWoB run</span></div>
          <p>Linux CPU integration on the larger curated set. The two visual-only pages were described but not acted on, and <code>read-table-2</code> stopped before entry. It remains useful as a broader task-set record, but is not directly comparable with the latest DOM-only Windows run.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-expanded-multi-tool-8ffc709.json">Raw run ↗</a>
        </article>
        <article>
          <div><strong>22/26</strong><span>Intermediate pointer run</span></div>
          <p>The exact-sender email flow passed, while duplicate nested menu targets caused a regression. The later pointer-wrapper fix restored that menu task; the two visual-only tasks and <code>read-table-2</code> still failed.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-expanded-multi-tool-00b7b13.json">Raw run ↗</a>
        </article>
        <article>
          <div><strong>20/26</strong><span>Earlier same-task run</span></div>
          <p>Same 26 tasks, seed, and action cap as the latest run, before local field-copy and multi-checkbox tools. Two outcomes changed from failure to success in the later run; this paired observation does not establish a general quality or speed improvement.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-expanded-multi-tool-60bec66.json">Raw run ↗</a>
        </article>
        <article>
          <div><strong>19/26</strong><span>Prior multi-tool baseline</span></div>
          <p>The same task set before support for MiniWoB's keyboard-operated sliders. It did not call <code>browser_set_range</code>; <code>use-slider-2</code> was the only task outcome that changed in the later run.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-expanded-multi-tool-b901f05.json">Raw run ↗</a>
        </article>
        <article>
          <div><strong>{focusedRun.successCount}/{focusedRun.episodeCount}</strong><span>Focused browser regressions</span></div>
          <p>Six previously troublesome MiniWoB cases on Linux CPU. Browser action-loop p50 258 ms / p95 721 ms, with zero semantic model calls. This is a targeted regression set, not a general success estimate.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-targeted-browser-fixes-8490bd7.json">Raw run ↗</a>
        </article>
        <article>
          <div><strong>8/8</strong><span>Focused MiniWoB smoke</span></div>
          <p>Eight curated tasks on Linux CPU. Browser action-loop p50 305 ms / p95 699 ms. One integration run; not a general success estimate.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-pointer-fastpath-diagnostic-rerun-smoke.json">Raw run ↗</a>
        </article>
        <article>
          <div><strong>{currentEightTaskRun.successCount}/{currentEightTaskRun.episodeCount}</strong><span>Current 8-task MiniWoB smoke · Windows CPU</span></div>
          <p>Eight curated tasks on commit <code>{currentEightTaskRun.suite.agentDecisionKitCommit.slice(0, 7)}</code>, with no timeouts. End-to-end latency including reset was p50 {currentEightTaskRun.latencyMs.p50} ms / p95 {currentEightTaskRun.latencyMs.p95} ms; the browser action loop was p50 {currentEightTaskRun.agentActionLatencyMs.p50} ms / p95 {currentEightTaskRun.agentActionLatencyMs.p95} ms. Three cached local model decisions had p95 {currentEightTaskRun.decisionCallLatencyMs.p95} ms (n=3); five tasks used local rules. This small smoke run does not establish general speed or quality.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-main-8-seed7-smoke.json">Summary and eight raw episodes ↗</a>
        </article>
        <article>
          <div><strong>{repeatedEightTaskRun.successCount}/{repeatedEightTaskRun.episodeCount}</strong><span>Eight-task regression · five seeds · Windows CPU</span></div>
          <p>The same eight curated tasks were repeated with seeds 7–11 after hierarchical menu handling was added. All episodes earned full raw reward with no timeouts. The prior matched run was 36/40, with all four failures in <code>click-menu</code>. End-to-end latency including reset was p50 {repeatedEightTaskRun.latencyMs.p50} ms / p95 {repeatedEightTaskRun.latencyMs.p95} ms; the browser decision/action loop was p50 {repeatedEightTaskRun.agentActionLatencyMs.p50} ms / p95 {repeatedEightTaskRun.agentActionLatencyMs.p95} ms. Eleven semantic provider calls had p95 {repeatedEightTaskRun.decisionCallLatencyMs.p95} ms. This paired result is a small regression check, not a broad browser score or speed claim.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-main-8-seed7-11-post-menu-fix-40.json">Post-fix aggregate and 40 raw episodes ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-main-8-seed7-11-pre-menu-fix-40.json">Matched pre-fix aggregate ↗</a>
        </article>
        <article>
          <div><strong>3/3</strong><span>Full-reward tool smoke</span></div>
          <p>Three explicitly selected tasks reached raw reward 1.0. The bounded, deterministic harness exercised checkbox batching, local field copy, and keyboard sliders. Browser-loop p50 927 ms / p95 1,005 ms; there were no semantic model calls. Synthetic submit approvals were limited to the local benchmark page. This is a small integration check, not a representative success estimate.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-post-reward-fix-smoke.json">Raw run ↗</a>
        </article>
        <article>
          <div><strong>{visualDigitsRetryRun.successCount}/{visualDigitsRetryRun.episodeCount}</strong><span>Visual digit OCR · five seeds</span></div>
          <p>One visual-only MiniWoB task, repeated with seeds 7–11 after bounded single-character retries were added for repeated digit glyphs. All five episodes reached full raw reward with five separately approved local clicks; seed 11 used two OCR retries to distinguish duplicate <code>4</code> readings. The pre-retry run reached {visualDigitsRun.successCount}/{visualDigitsRun.episodeCount}, so this is a narrow same-seed regression observation rather than a general OCR claim. End-to-end latency including reset was p50 {visualDigitsRetryRun.latencyMs.p50} ms / p95 {visualDigitsRetryRun.latencyMs.p95} ms; the browser/OCR action loop was p50 {visualDigitsRetryRun.agentActionLatencyMs.p50} ms / p95 {visualDigitsRetryRun.agentActionLatencyMs.p95} ms. This is one task on one Windows CPU machine, not representative BrowserGym coverage or a speed claim.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-visual-digits-single-char-retry-5-seed-smoke.json">Retry run summary and five raw episodes ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-visual-digits-5-seed-smoke.json">Pre-retry 4/5 baseline ↗</a>
        </article>
        <article>
          <div><strong>3/26</strong><span>Decision/action only</span></div>
          <p>A broader task mix that repeatedly called the decision/action tool without orchestrating form fills, native select options, or visual inspection.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/miniwob-expanded-smoke-suite.json">Raw run ↗</a>
        </article>
      </div>
      <p class="comparison-note">The latest 24-task DOM subset and prior 26-task run differ in task coverage, host, and source state; neither establishes general browser quality or speed. No Jev parity comparison has been run. The original multi-site WebArena and VisualWebArena suites have no results. A separate {verifiedNavigationCount}-task WebArena Verified sweep on one synthetic admin site reached full reward on {verifiedNavigationSuccesses}/{verifiedNavigationCount} tasks and partial reward on {verifiedNavigationPartial}; it remains a narrow navigation integration sample.</p>
      <a class="text-link" href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/README.md">Read the full protocol and reproduction commands →</a>
    </section>

    <section class="prerequisites" aria-labelledby="prerequisites-title">
      <p class="eyebrow">BROADER BROWSERGYM SETUPS</p>
      <h2 id="prerequisites-title">WebArena scores need running benchmark sites.</h2>
      <p class="prerequisite-lead">Installing BrowserGym alone does not provide the original WebArena or VisualWebArena sites. Their integrations need several configured domains; those full suites have no result here. The upstream combined VisualWebArena/WebArena Docker example recommends an EC2 host with a 1,000 GB EBS root volume, so check storage and prepare every service before a full run. The separate WebArena Verified run below covers {verifiedNavigationCount} read-only navigation tasks in one synthetic shopping_admin site.</p>
      <div class="setup-grid">
        <article>
          <h3>WebArena</h3>
          <p>Requires URLs for the shopping site and admin, Reddit, GitLab, Wikipedia, map, and homepage.</p>
          <code>WA_SHOPPING · WA_REDDIT · WA_GITLAB · WA_WIKIPEDIA · WA_MAP · WA_HOMEPAGE</code>
          <a href="https://github.com/ServiceNow/BrowserGym/blob/main/browsergym/webarena/README.md">BrowserGym WebArena setup ↗</a>
        </article>
        <article>
          <h3>VisualWebArena</h3>
          <p>Requires separate classifieds, shopping, Reddit, Wikipedia, and homepage URLs.</p>
          <code>VWA_CLASSIFIEDS · VWA_SHOPPING · VWA_REDDIT · VWA_WIKIPEDIA · VWA_HOMEPAGE</code>
          <a href="https://github.com/ServiceNow/BrowserGym/blob/main/browsergym/visualwebarena/README.md">BrowserGym VisualWebArena setup ↗</a>
          <a href="https://github.com/web-arena-x/visualwebarena/blob/main/environment_docker/README.md">Upstream Docker services and storage guide ↗</a>
        </article>
        <article>
          <h3>WebArena Verified · shopping admin</h3>
          <p>{verifiedNavigationCount} navigation episodes on synthetic Magento admin data produced {verifiedNavigationSuccesses} full task successes, {verifiedNavigationPartial} partial rewards, and {verifiedNavigationCount - verifiedNavigationSuccesses - verifiedNavigationPartial} zero rewards. No task timed out. Mean reward is {verifiedNavigationRun.meanReward.toFixed(3)}; the initial same-task baseline was {verifiedNavigationBaselineMeanReward.toFixed(3)}. Two theme settings tasks reached full reward with row-specific link context. When a decision sees a changing page fingerprint, the browser now waits up to 1.05 seconds for DOM readiness and network idle before retrying with a fresh snapshot. A focused working-tree follow-up now routes two previously zero tasks to Product Views and Bestsellers (0.5 reward each); it does not apply the requested dates or click Show Report, so neither report task is complete. See the two raw traces below. This single-site subset is not a full WebArena score.</p>
          <code>BrowserGym 0.14.3 · Windows CPU + SSH B Docker · full {verifiedNavigationSuccesses}/{verifiedNavigationCount} · partial {verifiedNavigationPartial} · end-to-end p50/p95 {(verifiedNavigationRun.latencyMs.p50 / 1000).toFixed(3)}/{(verifiedNavigationRun.latencyMs.p95 / 1000).toFixed(3)} s · decision-call p95 {verifiedNavigationDecisionP95} ms (n={verifiedNavigationRun.decisionCallLatencyMs.sampleCount})</code>
          <p>A separate synthetic 57-link choice repeated ten times took 317 ms on the first local CPU call and p50/p95 135/146 ms across nine warm calls. It measures the provider only, repeats one question, and does not include page inspection or actions; its low confidence was uncalibrated. See the <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/fixtures/browser-choice-latency-57.jsonl">fixture</a> and <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/browser-choice-latency-57-cpu-20261002.json">raw report</a>.</p>
          <p>A previous run of these same task IDs reported end-to-end p50/p95 {(verifiedNavigationPreviousRun.latencyMs.p50 / 1000).toFixed(3)}/{(verifiedNavigationPreviousRun.latencyMs.p95 / 1000).toFixed(3)} s and decision-call p95 {verifiedNavigationPreviousDecisionP95} ms (n={verifiedNavigationPreviousRun.decisionCallLatencyMs.sampleCount}). This pair of runs does not establish a general speed gain.</p>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-docker-b-page-settle-18-20261002-summary.json">Latest page-settle repeat with all 18 raw episodes ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-docker-b-report-menu-fix-task-711-20261002.json">Task 711 Product Views route trace ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-docker-b-report-menu-fix-task-713-20261002.json">Task 713 Bestsellers route trace ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-docker-b-localhost-18-20261002-summary.json">Previous localhost-origin repeat ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-shopping-admin-initial-18-task-baseline.json">Initial 18-task baseline ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-shopping-admin-ad6e1b3-157.json">Raw full-reward task ↗</a>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-shopping-admin-157-loop-guard.json">Earlier partial result ↗</a>
          <p><strong>Earlier cross-host baseline:</strong> the same {remoteVerifiedNavigationCount} tasks ran with the browser runner on Windows 10 and the pinned single-site benchmark in a loopback-only Linux Docker container reached over an SSH tunnel. That earlier run returned {remoteVerifiedNavigationRun.successCount} full, {remoteVerifiedNavigationRun.partialRewardCount} partial, and {remoteVerifiedNavigationCount - remoteVerifiedNavigationRun.successCount - remoteVerifiedNavigationRun.partialRewardCount} zero rewards. All records remain narrow single-site measurements; the original multi-site WebArena and VisualWebArena have not been evaluated here.</p>
          <code>End-to-end p50 / p95 {((remoteVerifiedNavigationRun.latencyMs.p50 / 1000).toFixed(3))} / {((remoteVerifiedNavigationRun.latencyMs.p95 / 1000).toFixed(3))} s · decision/action-call p95 {remoteVerifiedNavigationDecisionP95} ms · n={remoteVerifiedNavigationRun.decisionCallLatencyMs.sampleCount}</code>
          <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/results/webarena-verified-docker-b-18-summary.json">Cross-host aggregate with raw episodes ↗</a>
        </article>
      </div>
      <p class="comparison-note">The upstream WebArena guide notes that some fuzzy-match evaluations call a hosted GPT-4 judge. The default Agent Decision Kit benchmark path stays local and does not enable paid judging. See the <a href="https://github.com/krmdl/agent-decision-kit/blob/main/benchmarks/README.md#webarena-and-visualwebarena-prerequisites">prerequisites and evaluator policy</a>.</p>
