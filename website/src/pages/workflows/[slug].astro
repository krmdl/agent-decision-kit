---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { workflows } from "../../data/topics.js";
import { siteBase } from "../../utils/site.js";
export function getStaticPaths() { return workflows.map((workflow) => ({ params: { slug: workflow.slug }, props: { workflow } })); }
const { workflow } = Astro.props;
const faq = { "@context":"https://schema.org", "@type":"FAQPage", mainEntity:[{"@type":"Question", name:`Can ${workflow.short.toLowerCase()} prove that an agent's work is correct?`, acceptedAnswer:{"@type":"Answer",text:workflow.caveat}}] };
const related = workflow.related.map((slug) => workflows.find((item) => item.slug === slug) ?? null).filter(Boolean);
---
<BaseLayout title={`${workflow.title} | Agent Decision Kit`} description={workflow.description} canonicalPath={workflow.canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(faq)} slot="head" />
  <main class="topic">
    <nav class="crumb"><a href={`${siteBase}workflows/`}>Workflows</a><span>/</span>{workflow.short}</nav>
    <p class="eyebrow">CODING AGENT WORKFLOW · PRACTICAL GUIDE</p><h1>{workflow.title}</h1><p class="lead">{workflow.description}</p>
    <section><p class="eyebrow">THE PROBLEM</p><p>{workflow.problem}</p></section>
    <section class="method"><p class="eyebrow">HOW THIS TOOL WORKS</p><p>{workflow.method}</p></section>
    <section class="example"><p class="eyebrow">TRY IT</p><pre><code>{workflow.example}</code></pre></section>
    <section class="caveat"><p class="eyebrow">LIMITS</p><p>{workflow.caveat}</p></section>
    <section class="related"><p class="eyebrow">RELATED WORKFLOWS</p><div>{related.map((item) => <a href={`${siteBase}${item.canonicalPath}`}><b>{item.title}</b><span>Read next →</span></a>)}</div><a class="all" href={`${siteBase}features/`}>Browse feature guides →</a></section>
  </main>
</BaseLayout>
<style>
  .topic{max-width:920px;margin:auto;padding:48px 28px 0}.crumb{display:flex;gap:10px;color:#8298ad;font-size:13px;margin-bottom:42px}.crumb a{text-decoration:none}.eyebrow{color:var(--mint);font-size:11px;letter-spacing:.14em;font-weight:800;text-transform:uppercase}h1{font-size:clamp(40px,7vw,68px);line-height:1.02;letter-spacing:-.055em;margin:16px 0}.lead{font-size:19px;line-height:1.65;color:var(--muted);max-width:780px}.topic section{margin-top:18px;padding:25px;border:1px solid var(--line);background:var(--panel);border-radius:15px}.topic section>p:not(.eyebrow){color:#c2d0de;line-height:1.75}.method{border-left:3px solid var(--mint)!important}.example pre{overflow:auto;background:#06101a;border:1px solid #203449;border-radius:10px;padding:16px;color:#d3e8fc;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace}.caveat{background:#171f2b!important;border-color:#51383c!important}.caveat p:last-child{color:#d2c6c6!important}.related>div{display:grid;gap:10px}.related>div a{display:flex;justify-content:space-between;gap:20px;align-items:center;text-decoration:none;padding:14px;border:1px solid #263e54;border-radius:10px}.related>div b{color:var(--text);font-size:14px}.related>div span{font-size:12px;white-space:nowrap}.all{display:inline-block;margin-top:18px;font-size:14px}@media(max-width:600px){.topic{padding:38px 20px 0}.crumb{margin-bottom:28px}.related>div a{align-items:flex-start;flex-direction:column;gap:8px}}
</style>
