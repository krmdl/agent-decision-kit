---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { workflows } from "../../data/topics.js";
import { siteBase } from "../../utils/site.js";
---
<BaseLayout title="Coding Agent Workflow Guides | Agent Decision Kit" description="Practical guides for local Chrome tab selection, context pruning, model routing, repository navigation, diff risk review, and completion evidence checks." canonicalPath="workflows/">
  <main class="index-page"><p class="eyebrow">Workflow guides</p><h1>Use a small decision<br /><span>where it helps.</span></h1><p class="lead">These guides explain a focused agent workflow, show how its tool behaves, and spell out where its output is only a heuristic.</p>
    <div class="topic-list">{workflows.map((workflow) => <article><p class="eyebrow">CODING AGENT WORKFLOW</p><h2><a href={`${siteBase}${workflow.canonicalPath}`}>{workflow.title} →</a></h2><p>{workflow.description}</p><a href={`${siteBase}${workflow.canonicalPath}`}>Read the workflow guide</a></article>)}</div>
  </main>
</BaseLayout>
<style>
  .index-page{max-width:1000px;margin:auto;padding:72px 28px}.eyebrow{color:var(--mint);font-size:11px;letter-spacing:.14em;font-weight:800;text-transform:uppercase}h1{font-size:clamp(42px,7vw,72px);line-height:.98;letter-spacing:-.055em;margin:18px 0}h1 span{color:var(--mint)}.lead{color:var(--muted);font-size:18px;line-height:1.65;max-width:700px}.topic-list{display:grid;gap:14px;margin-top:42px}.topic-list article{padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}h2{font-size:23px;margin:8px 0}h2 a{color:var(--text);text-decoration:none}.topic-list article>p:not(.eyebrow){color:var(--muted);line-height:1.65;max-width:760px}.topic-list article>a:last-child{font-size:13px}
</style>
