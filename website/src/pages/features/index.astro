---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { features } from "../../data/topics.js";
import { siteBase } from "../../utils/site.js";
---
<BaseLayout title="Local MCP Features for Coding Agents | Agent Decision Kit" description="Explore bounded Playwright browser automation, typed decisions, and local model privacy controls for coding agents." canonicalPath="features/">
  <main class="index-page"><p class="eyebrow">Feature guides</p><h1>Tools with a defined<br /><span>job and boundary.</span></h1><p class="lead">Understand what each feature does, what state it sees, and where a person or larger model remains responsible.</p>
    <div class="topic-list">{features.map((feature) => <article><p class="eyebrow">FEATURE</p><h2><a href={`${siteBase}${feature.canonicalPath}`}>{feature.title} →</a></h2><p>{feature.description}</p><a href={`${siteBase}${feature.canonicalPath}`}>Read the feature guide</a></article>)}</div>
  </main>
</BaseLayout>
<style>
  .index-page{max-width:1000px;margin:auto;padding:72px 28px}.eyebrow{color:var(--mint);font-size:11px;letter-spacing:.14em;font-weight:800;text-transform:uppercase}h1{font-size:clamp(42px,7vw,72px);line-height:.98;letter-spacing:-.055em;margin:18px 0}h1 span{color:var(--mint)}.lead{color:var(--muted);font-size:18px;line-height:1.65;max-width:700px}.topic-list{display:grid;gap:14px;margin-top:42px}.topic-list article{padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}h2{font-size:23px;margin:8px 0}h2 a{color:var(--text);text-decoration:none}.topic-list article>p:not(.eyebrow){color:var(--muted);line-height:1.65;max-width:760px}.topic-list article>a:last-child{font-size:13px}
</style>
