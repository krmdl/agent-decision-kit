---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { features } from "../../data/topics.js";
import { siteBase } from "../../utils/site.js";
export function getStaticPaths() { return features.map((feature) => ({ params: { slug: feature.slug }, props: { feature } })); }
const { feature } = Astro.props;
const faq = { "@context":"https://schema.org", "@type":"FAQPage", mainEntity:[{"@type":"Question", name:`Is ${feature.short.toLowerCase()} a guarantee of correctness?`, acceptedAnswer:{"@type":"Answer",text:feature.caveat}}] };
const related = feature.related.map((slug) => features.find((item) => item.slug === slug) ?? null).filter(Boolean);
---
<BaseLayout title={`${feature.title} | Agent Decision Kit`} description={feature.description} canonicalPath={feature.canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(faq)} slot="head" />
  <main class="topic">
    <nav class="crumb"><a href={`${siteBase}features/`}>Features</a><span>/</span>{feature.short}</nav>
    <p class="eyebrow">FEATURE GUIDE · LOCAL MCP</p><h1>{feature.title}</h1><p class="lead">{feature.description}</p>
    <section class="intro"><p>{feature.intro}</p></section>
    <section><p class="eyebrow">HOW IT WORKS</p><h2>From current state to a bounded action</h2><ol>{feature.steps.map((step) => <li>{step}</li>)}</ol></section>
    <section class="caveat"><p class="eyebrow">LIMITS TO KEEP IN VIEW</p><p>{feature.caveat}</p></section>
    {feature.slug === "browser-agent" && <img class="diagram" src={`${siteBase}images/decision-flow.svg`} alt="Inspect, choose, approve sensitive actions, then act and return the page delta" width="1000" height="250" loading="lazy" />}
    {feature.slug === "browser-agent" && <figure class="visual-demo"><div><p class="eyebrow">OPTIONAL VISUAL FALLBACK</p><h2>When the page is only pixels.</h2><p>Canvas-only controls do not appear in the accessible DOM. Ask the local vision model what it can see; the response is descriptive and never clicks.</p><a href={`${siteBase}demos/visual-only-demo.html`}>Open the fake-data canvas demo →</a></div><img src={`${siteBase}images/visual-only-demo.png`} alt="Fake canvas task board with the visible buttons Open task, Save draft, and Delete draft" width="1280" height="800" loading="lazy" /></figure>}
    <section class="related"><p class="eyebrow">RELATED GUIDES</p><div>{related.map((item) => <a href={`${siteBase}${item.canonicalPath}`}><b>{item.title}</b><span>Continue reading →</span></a>)}</div><a class="all" href={`${siteBase}workflows/`}>See agent workflow guides →</a></section>
  </main>
</BaseLayout>
<style>
  .topic{max-width:920px;margin:auto;padding:48px 28px 0}.crumb{display:flex;gap:10px;color:#8298ad;font-size:13px;margin-bottom:42px}.crumb a{text-decoration:none}.eyebrow{color:var(--mint);font-size:11px;letter-spacing:.14em;font-weight:800;text-transform:uppercase}h1{font-size:clamp(40px,7vw,68px);line-height:1.02;letter-spacing:-.055em;margin:16px 0}.lead{font-size:19px;line-height:1.65;color:var(--muted);max-width:780px}.topic section{margin-top:25px;padding:25px;border:1px solid var(--line);background:var(--panel);border-radius:15px}.topic section h2{font-size:22px;margin:8px 0 18px}.topic section>p:not(.eyebrow){color:#c2d0de;line-height:1.7}.intro{border-left:3px solid var(--mint)!important}.intro p{font-size:17px}.topic ol{padding-left:24px;display:grid;gap:15px;color:#c7d4e0;line-height:1.65}.topic li::marker{color:var(--mint);font-weight:700}.caveat{background:#171f2b!important;border-color:#51383c!important}.caveat p:last-child{color:#d2c6c6!important}.diagram{width:100%;height:auto;border:1px solid var(--line);border-radius:16px;margin-top:25px}.visual-demo{display:grid;grid-template-columns:.7fr 1.3fr;gap:26px;align-items:center;margin:28px 0;padding:24px;border:1px solid var(--line);background:var(--panel);border-radius:16px}.visual-demo h2{font-size:25px;letter-spacing:-.035em;margin:8px 0}.visual-demo p:not(.eyebrow){color:var(--muted);line-height:1.65;font-size:14px}.visual-demo img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:10px}.related>div{display:grid;gap:10px}.related>div a{display:flex;justify-content:space-between;gap:20px;align-items:center;text-decoration:none;padding:14px;border:1px solid #263e54;border-radius:10px}.related>div b{color:var(--text);font-size:14px}.related>div span{font-size:12px;white-space:nowrap}.all{display:inline-block;margin-top:18px;font-size:14px}
  @media(max-width:700px){.visual-demo{grid-template-columns:1fr}}@media(max-width:600px){.topic{padding:38px 20px 0}.crumb{margin-bottom:28px}.related>div a{align-items:flex-start;flex-direction:column;gap:8px}}
</style>
