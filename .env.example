# semantic: free local embeddings; openai: local/remote OpenAI-compatible endpoint; jev: TypeSafe API
AGENT_DECISION_PROVIDER=semantic
AGENT_DECISION_MODEL=Xenova/all-MiniLM-L6-v2
# CPU is predictable across hosts; optional values include auto, dml (Windows), cuda (Linux x64), and coreml (macOS).
AGENT_DECISION_DEVICE=cpu
AGENT_DECISION_VISION_MODEL=HuggingFaceTB/SmolVLM2-500M-Video-Instruct

# OpenAI-compatible provider. A local Ollama endpoint is a no-fee option.
AGENT_DECISION_BASE_URL=http://127.0.0.1:11434/v1
AGENT_DECISION_API_KEY=
AGENT_DECISION_CHAT_MODEL=qwen2.5:3b

# Optional TypeSafe Jev provider. Calls are billed by TypeSafe.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Browser profile/storage stay on this machine.
AGENT_DECISION_BROWSER_DIR=.agent-decision/browser-profile
AGENT_DECISION_CDP_URL=http://127.0.0.1:9222
